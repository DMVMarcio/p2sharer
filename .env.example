# Root environment shared by the backend, web build/dev server and desktop build.
# Blank public URLs are derived automatically for development/production.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000
WEB_DEV_PORT=1422

# HTTP(S) origins, without /api. The broker can use an independent full WS(S) URL.
VITE_PUBLIC_SITE_URL=
VITE_PUBLIC_API_URL=
VITE_PUBLIC_BROKER_URL=

# Blank allowlists include the configured site/API origins and Tauri origins.
API_ALLOWED_ORIGINS=
BROKER_ALLOWED_ORIGINS=
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
BROKER_TRUST_PROXY=0
