{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "windows": {
      "wix": {
        "language": "en-US",
        "fragmentPaths": [
          "windows/nsis-migration.wxs"
        ],
        "componentRefs": [
          "MigrateNsisUser",
          "MigrateNsisMachine"
        ]
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "PortugueseBR",
          "Spanish",
          "French",
          "German",
          "Italian",
          "SimpChinese",
          "TradChinese",
          "Japanese",
          "Korean",
          "Hindi",
          "Finnish",
          "Russian"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "windows/installer-hooks.nsh",
        "customLanguageFiles": {
          "Hindi": "windows/locales/Hindi.nsh",
          "Finnish": "windows/locales/Finnish.nsh"
        }
      }
    }
  }
}
