# Copy to .env.production on the build machine and VPS. Do not commit real .env files.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000
WEB_DEV_PORT=1422

VITE_PUBLIC_SITE_URL=https://p2sharer.com
VITE_PUBLIC_API_URL=https://api.p2sharer.com
VITE_PUBLIC_BROKER_URL=wss://api.p2sharer.com/mqtt

API_ALLOWED_ORIGINS=
BROKER_ALLOWED_ORIGINS=

BROKER_TRUST_PROXY=0

# Optional first-party Coturn REST API (use-auth-secret) fallback relay.
# Blank TURN_URLS derives UDP/TCP port 3478 from VITE_PUBLIC_API_URL when TURN_SHARED_SECRET is set.
TURN_SHARED_SECRET=
TURN_URLS=
TURN_CREDENTIAL_TTL=21600
TURN_MAX_PER_IP=24
